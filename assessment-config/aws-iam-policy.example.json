{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "CheckAssessmentBucket",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::YOUR_ASSESSMENT_BUCKET"
    },
    {
      "Sid": "ReadAndWriteAssessmentObjects",
      "Effect": "Allow",
      "Action": ["s3:GetObject", "s3:GetObjectVersion", "s3:PutObject"],
      "Resource": "arn:aws:s3:::YOUR_ASSESSMENT_BUCKET/assessment/*"
    },
    {
      "Sid": "RemoveOnlyReadinessProbes",
      "Effect": "Allow",
      "Action": ["s3:DeleteObject", "s3:DeleteObjectVersion"],
      "Resource": "arn:aws:s3:::YOUR_ASSESSMENT_BUCKET/assessment/readiness/*"
    }
  ]
}
