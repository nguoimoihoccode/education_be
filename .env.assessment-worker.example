# Copy to .env.assessment-worker on the VPS (chmod 600).
# Use the same random token in .env.assessment-inference (openssl rand -hex 32).
ASSESSMENT_INFERENCE_TOKEN=
# Keep the audit seed stable across retries (openssl rand -hex 32).
ASSESSMENT_AUDIT_SEED=

# Optional outbound text-only route. Shared nonsecret policy goes in .env.prod.
ASSESSMENT_EXTERNAL_GRADING_URL=http://assessment-external-grading:8000
ASSESSMENT_EXTERNAL_GRADING_TOKEN=
ASSESSMENT_EXTERNAL_GRADING_SIGNING_KEY=
# ASSESSMENT_EXTERNAL_GRADING_MAX_CALLS_PER_SUBMISSION=5
