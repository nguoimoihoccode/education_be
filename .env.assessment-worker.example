# Copy to .env.assessment-worker on the VPS (chmod 600), never commit secrets.
# Provider credentials and the audit sampling seed go here; infrastructure comes from
# Compose's --env-file. Add exact credentialRef names from private routing.json.
ASSESSMENT_GOOGLE_API_KEY=
ASSESSMENT_DEEPSEEK_API_KEY=
# Keep this seed stable across retries; generate during setup: openssl rand -hex 32
ASSESSMENT_AUDIT_SEED=
