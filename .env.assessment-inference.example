# Copy to .env.assessment-inference on the VPS (chmod 600).
# Copy the same token from .env.assessment-worker.
ASSESSMENT_INFERENCE_TOKEN=
# Model server is independently provisioned on assessment-inference-net.
# Use the assessment-local-model network alias and origin without a path.
ASSESSMENT_LOCAL_MODEL_URL=
ASSESSMENT_LOCAL_MODEL_NAME=
ASSESSMENT_LOCAL_MODEL_TOKEN=
