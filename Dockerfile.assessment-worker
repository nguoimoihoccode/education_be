# Independent worker image: no API listener, local model weights, or host tools.
FROM node:22.14.0-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
# Explicit inputs avoid copying runtime .env files or private keys into layers.
COPY nest-cli.json tsconfig*.json ./
COPY src ./src
RUN npm run build

FROM node:22.14.0-alpine AS production
WORKDIR /app
RUN apk add --no-cache poppler-utils font-dejavu \
    && addgroup -g 1001 -S nodejs \
    && adduser -S nestjs -u 1001 -G nodejs \
    && mkdir -p /app/workspace \
    && chown nestjs:nodejs /app/workspace
COPY --chown=nestjs:nodejs package*.json ./
# sharp must be a production dependency, including its platform optional binaries.
RUN npm ci --omit=dev && npm cache clean --force
COPY --chown=nestjs:nodejs --from=builder /app/dist ./dist
COPY --chown=nestjs:nodejs docs/assessment/contracts ./docs/assessment/contracts
# Build-time smoke test: font embedding and the real Poppler renderer on synthetic data.
RUN node -e 'const PDF=require("pdfkit");const fs=require("fs");const p=new PDF();p.pipe(fs.createWriteStream("/tmp/assessment-smoke.pdf"));p.font("/usr/share/fonts/ttf-dejavu/DejaVuSans.ttf").text("Kiem tra PDF");p.end();' \
    && pdftoppm -f 1 -singlefile -scale-to 64 -jpeg /tmp/assessment-smoke.pdf /tmp/assessment-smoke \
    && test -s /tmp/assessment-smoke.jpg \
    && rm -f /tmp/assessment-smoke.pdf /tmp/assessment-smoke.jpg
ENV NODE_ENV=production \
    ASSESSMENT_WORKSPACE_PATH=/app/workspace \
    ASSESSMENT_WORKER_HEARTBEAT_PATH=/app/workspace/heartbeat
USER nestjs
HEALTHCHECK --interval=30s --timeout=5s --start-period=60s --retries=3 \
    CMD node -e "try { process.exit(Date.now() - require('fs').statSync(process.env.ASSESSMENT_WORKER_HEARTBEAT_PATH).mtimeMs < 120000 ? 0 : 1); } catch { process.exit(1); }"
CMD ["node", "dist/workers/assessment-worker.main.js"]
