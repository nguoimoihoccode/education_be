{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://assessment.local/design/grading-output.schema.json",
  "title": "Rubric/drawing grader output v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "examVersionId",
    "submissionId",
    "inputRevision",
    "results"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "examVersionId": {
      "type": "string",
      "format": "uuid"
    },
    "submissionId": {
      "type": "string",
      "format": "uuid"
    },
    "inputRevision": {
      "type": "integer",
      "minimum": 1
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "questionKey",
          "criterionGrades",
          "blockingCodes"
        ],
        "properties": {
          "questionKey": {
            "type": "string",
            "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
          },
          "criterionGrades": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "criterionId",
                "pointsUnits",
                "reason",
                "evidenceRegionIds"
              ],
              "properties": {
                "criterionId": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9]+(?:[._-][A-Za-z0-9]+)*$"
                },
                "pointsUnits": {
                  "type": [
                    "integer",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 1000000
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 2000
                },
                "evidenceRegionIds": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  },
                  "uniqueItems": true
                }
              },
              "allOf": [
                {
                  "if": {
                    "properties": {
                      "pointsUnits": {
                        "type": "integer"
                      }
                    }
                  },
                  "then": {
                    "properties": {
                      "evidenceRegionIds": {
                        "minItems": 1
                      }
                    }
                  }
                }
              ]
            }
          },
          "blockingCodes": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "enum": [
                "unreadable_evidence",
                "insufficient_evidence",
                "rubric_ambiguous",
                "cannot_assess_drawing",
                "conflicting_observation"
              ]
            }
          }
        }
      }
    }
  }
}
