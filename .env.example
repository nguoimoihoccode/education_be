# ===========================================
# SUPABASE DATABASE CONFIGURATION
# ===========================================
DB_HOST=aws-1-ap-south-1.pooler.supabase.com
DB_PORT=6543
DB_USERNAME=postgres.your-project-id
DB_PASSWORD=your-database-password
DB_DATABASE=postgres

# ===========================================
# JWT CONFIGURATION (RS256 with RSA Keys)
# ===========================================
# IMPORTANT: This application uses RS256 (RSA) for JWT signing
# The old JWT_SECRET and JWT_REFRESH_SECRET are legacy only
#
# RSA keys must be placed in the 'keys/' directory:
# - keys/private.pem (for signing tokens)
# - keys/public.pem (for verifying tokens)
#
# To generate RSA keys, run:
#   mkdir -p keys
#   openssl genrsa -out keys/private.pem 2048
#   openssl rsa -in keys/private.pem -pubout -out keys/public.pem
#
# NEVER commit private.pem to version control!
# The keys/ directory is already in .gitignore

# Option A: Load keys from files
JWT_PRIVATE_KEY_PATH=keys/private.pem
JWT_PUBLIC_KEY_PATH=keys/public.pem

# Option B: Load keys directly from env (escaped newlines)
# JWT_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# Token Expiry Settings (optional - defaults shown)
# JWT_ACCESS_TOKEN_EXPIRY=15m
# JWT_REFRESH_TOKEN_EXPIRY=7d

# Supabase API Keys (Optional - for direct Supabase client)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# SERVER CONFIGURATION
# ===========================================
PORT=3000
NODE_ENV=development

# ===========================================
# GOOGLE OAUTH
# ===========================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# ===========================================
# MEDIA UPLOADS
# ===========================================
MEDIA_STORAGE_PATH=uploads
EDUCATION_AVATAR_STORAGE_PATH=uploads/education
EDUCATION_EXPORT_STORAGE_PATH=exports/education
# Optional. Defaults to current server host if omitted.
# MEDIA_PUBLIC_BASE_URL=http://localhost:3000

# ===========================================
# RATE LIMITING (OPTIONAL)
# ===========================================
# THROTTLE_TTL=60
# THROTTLE_LIMIT=100
