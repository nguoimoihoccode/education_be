# Copy this file to .env.prod on the VPS. Never commit the real .env.prod file.

# Image values are fallback defaults. GitHub Actions overrides them during deploy.
BACKEND_IMAGE=ghcr.io/OWNER/REPO/education-be
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/education-fe
IMAGE_TAG=latest

# PostgreSQL (managed by the `db` service in docker-compose.prod.yml)
POSTGRES_USER=stockvn
POSTGRES_PASSWORD=strong-password
POSTGRES_DB=stockvn

# Backend runtime
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-domain.com
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# PostgreSQL (backend connects to the `db` service; values overridden by compose)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=stockvn
DB_PASSWORD=strong-password
DB_DATABASE=stockvn
ALLOW_DB_SYNC=false

# JWT RS256. Prefer multiline-capable secret values copied into the VPS .env.prod.
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Supabase/media
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_STORAGE_PATH=uploads
MEDIA_PUBLIC_BASE_URL=https://your-domain.com/uploads

# Rate limits
THROTTLE_TTL=60
THROTTLE_LIMIT=100
