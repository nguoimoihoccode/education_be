# Copy this file to .env.prod on the VPS. Never commit the real .env.prod file.

# Image values are fallback defaults. GitHub Actions overrides them during deploy.
DB_IMAGE=ghcr.io/OWNER/REPO/education-postgres
DB_IMAGE_TAG=16.4-pgvector
BACKEND_IMAGE=ghcr.io/OWNER/REPO/education-be
FRONTEND_IMAGE=ghcr.io/OWNER/REPO/education-fe
IMAGE_TAG=latest

# PostgreSQL (managed by the `db` service in docker-compose.prod.yml)
POSTGRES_USER=stockvn
POSTGRES_PASSWORD=strong-password
POSTGRES_DB=stockvn

# Backend runtime
NODE_ENV=production
PORT=3000
FRONTEND_URL=https://your-domain.com
GOOGLE_CALLBACK_URL=https://your-domain.com/api/auth/google/callback

# PostgreSQL (backend connects to the `db` service; values overridden by compose)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=stockvn
DB_PASSWORD=strong-password
DB_DATABASE=stockvn
ALLOW_DB_SYNC=false

# JWT RS256. Prefer multiline-capable secret values copied into the VPS .env.prod.
JWT_PRIVATE_KEY_PATH=/app/keys/private.pem
JWT_PUBLIC_KEY_PATH=/app/keys/public.pem

# Optional Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Supabase/media
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MEDIA_STORAGE_PATH=uploads
MEDIA_PUBLIC_BASE_URL=https://your-domain.com/uploads

# Rate limits
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Shared Redis (optional but recommended in production; in-memory fallbacks
# are used when unset). Enables: two-tier cache, cross-instance rate limits,
# and the BullMQ document-parse queue.
# docker-compose.prod.yml already points this at the `redis` service
REDIS_URL=redis://redis:6379

# AI assessment is off until the VPS readiness/pilot gate is complete.
# Compose profile activation alone does not enable the application feature.
ASSESSMENT_ENABLED=false
# Set explicitly to redis://assessment-redis:6379 only when enabling the profile.
ASSESSMENT_QUEUE_REDIS_URL=
ASSESSMENT_WORKER_IMAGE=stock-assessment-worker
ASSESSMENT_INFERENCE_IMAGE=stock-assessment-inference
# The Python worker owns all four stages. Leave the line commented out for the
# default (seal,extract,grade,export); uncomment it with no value to pause
# claiming during an incident, or list a subset to narrow it. An empty value is
# not the same as unset: compose turns an empty one into "claim nothing".
# ASSESSMENT_WORKER_PYTHON_STAGES=seal,extract,grade,export
ASSESSMENT_WORKER_DB_POOL=4
# Host directory containing a private, validated pilot routing snapshot.
ASSESSMENT_CONFIG_DIR=./assessment-config
# Set to /app/assessment-config/routing.json after provisioning that file.
ASSESSMENT_ROUTING_CONFIG_PATH=
ASSESSMENT_WORKER_ENV_FILE=./.env.assessment-worker
ASSESSMENT_INFERENCE_ENV_FILE=./.env.assessment-inference
ASSESSMENT_EXTERNAL_GRADING_ENV_FILE=./.env.assessment-external-grading
# Nonsecret policy shared by the API and Node worker. The gateway has its own switch.
ASSESSMENT_EXTERNAL_GRADING_ENABLED=false
ASSESSMENT_EXTERNAL_GRADING_POLICY=
ASSESSMENT_EXTERNAL_GRADING_ASSESSMENT_IDS=
ASSESSMENT_STORAGE_DRIVER=s3
# External private S3-compatible service, reachable via HTTPS by browser + VPS.
ASSESSMENT_S3_ENDPOINT=
ASSESSMENT_S3_REGION=
ASSESSMENT_S3_BUCKET=
ASSESSMENT_S3_FORCE_PATH_STYLE=false
# Inject restricted runtime secrets; never commit credentials.
ASSESSMENT_S3_ACCESS_KEY_ID=
ASSESSMENT_S3_SECRET_ACCESS_KEY=
