# This Dockerfile needs docs/assessment/contracts; the API ignore excludes docs.
# Restrict the build context to the worker's explicit build inputs.
**
!package.json
!package-lock.json
!nest-cli.json
!tsconfig*.json
!src/
!src/**
!docs/
!docs/assessment/
!docs/assessment/contracts/
!docs/assessment/contracts/**
# Never include local secrets, even if placed under an allowed source directory.
**/.env*
**/*.pem
**/node_modules
**/.DS_Store
