# Copy to .env.assessment-external-grading with mode 600 for an approved pilot.
ASSESSMENT_EXTERNAL_GRADING_ENABLED=false
# Match the token and signing key in the worker env file. Generate them with
# separate openssl rand -hex 32 calls.
ASSESSMENT_EXTERNAL_GRADING_TOKEN=
ASSESSMENT_EXTERNAL_GRADING_SIGNING_KEY=
# Match the policy version in .env.prod.
ASSESSMENT_EXTERNAL_GRADING_POLICY=
# Provider and model are fixed at the gateway and absent from worker payloads.
ASSESSMENT_EXTERNAL_GRADING_PROVIDER=
ASSESSMENT_EXTERNAL_GRADING_MODEL=
ASSESSMENT_EXTERNAL_GRADING_API_KEY=
